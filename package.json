{
  "name": "dsh-know-yourself-through-play",
  "version": "0.1.0",
  "description": "A psychology-informed, memory-enabled gaming companion for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": { ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" } },
  "bin": { "kytp": "lib/cli.js" },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "docs", "examples", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Godel-Infinity-Machine/know-yourself-through-play.git" },
  "engines": { "node": ">=24.22.3", "dsh": "0.2.3-alpha.2" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "bench": "node scripts/bench.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "audit:source": "node scripts/audit.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
